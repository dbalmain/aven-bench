  "title": "Gigasecond",
  "blurb": "Given a moment, determine the moment that would be after a gigasecond has passed.",
  "source": "exercism/problem-specifications",
  "sourceCommit": "22e2aa465858fc497ef3b6b9dbb82e706ac8569c",
